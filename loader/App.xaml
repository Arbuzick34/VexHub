<Application x:Class="VexHub.Loader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Resources/Lang.en.xaml" />
      </ResourceDictionary.MergedDictionaries>

      <FontFamily x:Key="UiFont">./Assets/fonts/#Roboto Medium</FontFamily>
      <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

      <SolidColorBrush x:Key="TextBrush" Color="#F4F3F8" />
      <SolidColorBrush x:Key="SoftBrush" Color="#D7D3DF" />
      <SolidColorBrush x:Key="MutedBrush" Color="#A09DA9" />
      <SolidColorBrush x:Key="DimBrush" Color="#6F6B78" />
      <SolidColorBrush x:Key="FaintBrush" Color="#4A4653" />
      <SolidColorBrush x:Key="FaintestBrush" Color="#3A3742" />
      <SolidColorBrush x:Key="PendingTitleBrush" Color="#8F8B98" />
      <SolidColorBrush x:Key="LineBrush" Color="#17FFFFFF" />
      <SolidColorBrush x:Key="LineSoftBrush" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="RowLineBrush" Color="#0AFFFFFF" />
      <SolidColorBrush x:Key="TrackBrush" Color="#14FFFFFF" />
      <SolidColorBrush x:Key="SunkenBrush" Color="#0A0A0E" />
      <SolidColorBrush x:Key="FieldBorderBrush" Color="#262631" />
      <SolidColorBrush x:Key="PanelBorderBrush" Color="#20202B" />
      <SolidColorBrush x:Key="AccentBrush" Color="#8B5CF6" />
      <SolidColorBrush x:Key="AccentBrightBrush" Color="#A78BFA" />
      <SolidColorBrush x:Key="OkBrush" Color="#3DDC97" />
      <SolidColorBrush x:Key="WarnBrush" Color="#F5B544" />
      <SolidColorBrush x:Key="DangerBrush" Color="#F2555A" />
      <SolidColorBrush x:Key="DangerTextBrush" Color="#FF9A9E" />
      <SolidColorBrush x:Key="DisabledBrush" Color="#15151C" />
      <SolidColorBrush x:Key="ActiveRowBrush" Color="#0E8B5CF6" />
      <SolidColorBrush x:Key="ErrorRowBrush" Color="#12F2555A" />
      <SolidColorBrush x:Key="WarnRowBrush" Color="#0AF5B544" />
      <SolidColorBrush x:Key="BadgeIdleBrush" Color="#05FFFFFF" />
      <SolidColorBrush x:Key="BadgeBusyBrush" Color="#148B5CF6" />
      <SolidColorBrush x:Key="BadgeActiveBrush" Color="#143DDC97" />
      <SolidColorBrush x:Key="BadgeErrorBrush" Color="#1AF2555A" />
      <SolidColorBrush x:Key="BadgeBusyBorderBrush" Color="#3D8B5CF6" />
      <SolidColorBrush x:Key="BadgeActiveBorderBrush" Color="#333DDC97" />
      <SolidColorBrush x:Key="BadgeErrorBorderBrush" Color="#33F2555A" />
      <SolidColorBrush x:Key="LogTimeBrush" Color="#4E4A56" />
      <SolidColorBrush x:Key="LogTextBrush" Color="#97929F" />

      <LinearGradientBrush x:Key="PanelBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#15121F" Offset="0" />
        <GradientStop Color="#101016" Offset="0.22" />
        <GradientStop Color="#0B0B10" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="HairlineBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#008B5CF6" Offset="0" />
        <GradientStop Color="#A6A78BFA" Offset="0.5" />
        <GradientStop Color="#008B5CF6" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#9668F8" Offset="0" />
        <GradientStop Color="#7C4DFF" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="PrimaryHoverBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#A175FF" Offset="0" />
        <GradientStop Color="#8B5CF6" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="AccentBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#7C4DFF" Offset="0" />
        <GradientStop Color="#A78BFA" Offset="1" />
      </LinearGradientBrush>
      <LinearGradientBrush x:Key="OkBarBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#26B87A" Offset="0" />
        <GradientStop Color="#5EEAD4" Offset="1" />
      </LinearGradientBrush>

      <!-- в”Ђв”Ђ glyphs в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
      <Style x:Key="Glyph" TargetType="Path">
        <Setter Property="Fill" Value="{x:Null}" />
        <Setter Property="Stroke" Value="{StaticResource FaintBrush}" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
      <Style x:Key="StepIcon" TargetType="Path" BasedOn="{StaticResource Glyph}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
      </Style>
      <Style x:Key="StepSpinner" TargetType="Ellipse">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Stroke" Value="{StaticResource AccentBrightBrush}" />
        <Setter Property="StrokeThickness" Value="1.5" />
        <Setter Property="StrokeDashArray" Value="5 14" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
      </Style>
      <Style x:Key="StepDot" TargetType="Ellipse">
        <Setter Property="Width" Value="4" />
        <Setter Property="Height" Value="4" />
        <Setter Property="Fill" Value="{StaticResource FaintBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
      </Style>
      <Style x:Key="StepCheck" TargetType="Path" BasedOn="{StaticResource Glyph}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stroke" Value="{StaticResource OkBrush}" />
        <Setter Property="StrokeThickness" Value="2.4" />
        <Setter Property="Visibility" Value="Collapsed" />
      </Style>
      <Style x:Key="StepAlert" TargetType="Path" BasedOn="{StaticResource Glyph}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Stroke" Value="{StaticResource DangerBrush}" />
        <Setter Property="StrokeThickness" Value="1.8" />
        <Setter Property="Visibility" Value="Collapsed" />
      </Style>
      <Style x:Key="StepTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{StaticResource PendingTitleBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>
      <Style x:Key="StepDetail" TargetType="TextBlock">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="Margin" Value="0,1,0,0" />
        <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
      </Style>

      <!-- в”Ђв”Ђ surfaces в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
      <Style x:Key="Card" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="#060609" />
        <Setter Property="BorderBrush" Value="{StaticResource LineSoftBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
      </Style>
      <!-- в”Ђв”Ђ buttons в”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђв”Ђ -->
      <Style x:Key="WindowButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#10FFFFFF" />
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#18FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" CornerRadius="6" Background="{TemplateBinding Background}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#24F2555A" />
                  <Setter Property="Foreground" Value="{StaticResource DangerTextBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#38F2555A" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LangButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
        <Setter Property="FontSize" Value="9" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border Background="Transparent" BorderBrush="{StaticResource LineBrush}" BorderThickness="1,0,0,0" Padding="10,0,0,0" Height="18">
                <ContentPresenter VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <ContentPresenter VerticalAlignment="Center" />
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="FooterLink" TargetType="Button" BasedOn="{StaticResource LinkButton}">
        <Setter Property="Foreground" Value="{StaticResource DimBrush}" />
      </Style>

      <Style x:Key="PrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="42" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" SnapsToDevicePixels="True">
                <Border.Effect>
                  <DropShadowEffect Color="#8B5CF6" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.42" />
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="{StaticResource PrimaryHoverBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                  <Setter TargetName="Chrome" Property="Background" Value="{StaticResource DisabledBrush}" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource LineBrush}" />
                  <Setter TargetName="Chrome" Property="Effect" Value="{x:Null}" />
                  <Setter Property="Foreground" Value="{StaticResource FaintBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#0BFFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="Foreground" Value="{StaticResource SoftBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Chrome" CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#12FFFFFF" />
                  <Setter TargetName="Chrome" Property="BorderBrush" Value="#2AFFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Chrome" Property="Background" Value="#08FFFFFF" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="BusyButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
        <Setter Property="Background" Value="#178B5CF6" />
        <Setter Property="BorderBrush" Value="#3E2E63" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border CornerRadius="10" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#17171E" />
        <Setter Property="Foreground" Value="{StaticResource SoftBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ToolTip">
              <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
                <ContentPresenter />
              </Border>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>

      <Style x:Key="StepRow" TargetType="Border">
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="BorderBrush" Value="{StaticResource RowLineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="Background" Value="Transparent" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
