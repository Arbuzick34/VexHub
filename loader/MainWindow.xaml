<Window x:Class="VexHub.Loader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:VexHub.Loader.Core"
        Title="{DynamicResource AppTitle}"
        Width="464"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">

  <Window.Resources>
    <DataTemplate x:Key="StepRowTemplate">
      <Border x:Name="Row" Style="{StaticResource StepRow}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
          </Grid.ColumnDefinitions>

          <Grid Width="16" Height="16" VerticalAlignment="Center">
            <Path x:Name="StepIcon" Data="{Binding Icon}" Style="{StaticResource StepIcon}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Ellipse x:Name="StepSpinner" Style="{StaticResource StepSpinner}" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Ellipse.RenderTransform>
                <RotateTransform x:Name="SpinRotate" />
              </Ellipse.RenderTransform>
            </Ellipse>
          </Grid>

          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="StepTitle" Text="{Binding Title}" Style="{StaticResource StepTitle}" />
            <TextBlock x:Name="StepDetail" Text="{Binding Detail}" Style="{StaticResource StepDetail}" />
          </StackPanel>

          <Grid Grid.Column="2" Width="16" Height="16" VerticalAlignment="Center">
            <Ellipse x:Name="StepDot" Style="{StaticResource StepDot}" />
            <Path x:Name="StepCheck" Data="{x:Static core:Icons.Check}" Style="{StaticResource StepCheck}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Path x:Name="StepAlert" Data="{x:Static core:Icons.Alert}" Style="{StaticResource StepAlert}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>

      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding State}" Value="Active">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource ActiveRowBrush}" />
          <Setter TargetName="StepIcon" Property="Visibility" Value="Hidden" />
          <Setter TargetName="StepSpinner" Property="Visibility" Value="Visible" />
          <Setter TargetName="StepDot" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource TextBrush}" />
          <Setter TargetName="StepDetail" Property="Foreground" Value="{StaticResource AccentBrightBrush}" />
          <DataTrigger.EnterActions>
            <BeginStoryboard x:Name="StepSpinStory">
              <Storyboard>
                <DoubleAnimation Storyboard.TargetName="SpinRotate"
                                 Storyboard.TargetProperty="Angle"
                                 From="0" To="360"
                                 Duration="0:0:0.85"
                                 RepeatBehavior="Forever" />
              </Storyboard>
            </BeginStoryboard>
          </DataTrigger.EnterActions>
          <DataTrigger.ExitActions>
            <StopStoryboard BeginStoryboardName="StepSpinStory" />
          </DataTrigger.ExitActions>
        </DataTrigger>

        <DataTrigger Binding="{Binding State}" Value="Done">
          <Setter TargetName="StepIcon" Property="Stroke" Value="{StaticResource OkBrush}" />
          <Setter TargetName="StepDot" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="StepCheck" Property="Visibility" Value="Visible" />
          <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource SoftBrush}" />
          <Setter TargetName="StepDetail" Property="Foreground" Value="{StaticResource DimBrush}" />
        </DataTrigger>

        <DataTrigger Binding="{Binding State}" Value="Warn">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource WarnRowBrush}" />
          <Setter TargetName="StepIcon" Property="Stroke" Value="{StaticResource WarnBrush}" />
          <Setter TargetName="StepDot" Property="Fill" Value="{StaticResource WarnBrush}" />
          <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource SoftBrush}" />
          <Setter TargetName="StepDetail" Property="Foreground" Value="#C6A467" />
        </DataTrigger>

        <DataTrigger Binding="{Binding State}" Value="Error">
          <Setter TargetName="Row" Property="Background" Value="{StaticResource ErrorRowBrush}" />
          <Setter TargetName="StepIcon" Property="Stroke" Value="{StaticResource DangerBrush}" />
          <Setter TargetName="StepDot" Property="Visibility" Value="Collapsed" />
          <Setter TargetName="StepAlert" Property="Visibility" Value="Visible" />
          <Setter TargetName="StepTitle" Property="Foreground" Value="{StaticResource TextBrush}" />
          <Setter TargetName="StepDetail" Property="Foreground" Value="{StaticResource DangerTextBrush}" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate x:Key="LogRowTemplate">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="52" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{Binding Time}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource LogTimeBrush}" LineHeight="14" LineStackingStrategy="BlockLineHeight" />
        <TextBlock Grid.Column="1" Text="{Binding Text}" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource LogTextBrush}" TextTrimming="CharacterEllipsis" LineHeight="14" LineStackingStrategy="BlockLineHeight" />
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Grid x:Name="Surface">
    <Border x:Name="ShotBackground" Background="#09090C" Visibility="Collapsed" />
    <Grid x:Name="Root" Margin="30">
      <Border x:Name="Panel" CornerRadius="16" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1">
        <Border.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="38" ShadowDepth="16" Direction="270" Opacity="0.7" />
        </Border.Effect>

        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <Rectangle Height="1" VerticalAlignment="Top" Fill="{StaticResource HairlineBrush}" Margin="48,0" IsHitTestVisible="False" />

          <Grid x:Name="TitleBar" Grid.Row="0" Margin="13,0,8,0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource AccentBrush}">
                <Path Data="{x:Static core:Icons.Logo}" Stroke="White" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="12" Height="10" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
              </Border>
              <TextBlock FontSize="11" FontWeight="Bold" Foreground="{StaticResource SoftBrush}" Margin="9,0,0,0" VerticalAlignment="Center">V&#x2009;E&#x2009;X&#x2009;H&#x2009;U&#x2009;B</TextBlock>
              <Border Background="#0FFFFFFF" BorderBrush="{StaticResource LineSoftBrush}" BorderThickness="1" CornerRadius="5" Padding="5,1" Margin="9,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="1.2.3" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource DimBrush}" />
              </Border>
              <Button x:Name="LangButton" Content="RU" Style="{StaticResource LangButton}" Margin="6,0,0,0" VerticalAlignment="Center" Click="Lang_Click" ToolTip="{DynamicResource LangTooltip}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <Button x:Name="MinButton" Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="{DynamicResource MinTooltip}">
                <Path Data="{x:Static core:Icons.Minus}" Style="{StaticResource Glyph}" Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
              </Button>
              <Button x:Name="CloseButton" Style="{StaticResource WindowCloseButton}" Click="Close_Click" Margin="2,0,0,0" ToolTip="{DynamicResource CloseTooltip}">
                <Path Data="{x:Static core:Icons.Close}" Style="{StaticResource Glyph}" Width="13" Height="13" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" />
              </Button>
            </StackPanel>
          </Grid>

          <StackPanel Grid.Row="1" Margin="17,14,17,13">
            <StackPanel Margin="0,0,0,11">
              <TextBlock Text="{DynamicResource Eyebrow}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentBrightBrush}" />
              <TextBlock Text="{DynamicResource Heading}" FontSize="17" FontWeight="Bold" Foreground="{StaticResource TextBrush}" Margin="0,3,0,0" />
              <TextBlock Text="{DynamicResource Subheading}" FontSize="11" Foreground="{StaticResource DimBrush}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border x:Name="ErrorPanel" Visibility="Collapsed" Margin="0,0,0,11" Padding="9,7" CornerRadius="9"
                    Background="{StaticResource ErrorRowBrush}" BorderBrush="#33F2555A" BorderThickness="1">
              <StackPanel Orientation="Horizontal">
                <Path Data="{x:Static core:Icons.Alert}" Style="{StaticResource Glyph}" Width="13" Height="13" Stroke="{StaticResource DangerBrush}" VerticalAlignment="Top" Margin="0,1,0,0" />
                <TextBlock x:Name="ErrorText" FontSize="10.5" Foreground="{StaticResource DangerTextBrush}" Margin="7,0,0,0" TextWrapping="Wrap" MaxWidth="330" />
              </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,0,11">
              <StackPanel>
                <Grid Margin="11,9,11,9">
                  <TextBlock Text="{DynamicResource SessionLabel}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                  <Border x:Name="Badge" HorizontalAlignment="Right" CornerRadius="9" Padding="7,2,8,2" BorderThickness="1" BorderBrush="{StaticResource LineSoftBrush}" Background="#05FFFFFF">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse x:Name="BadgeDot" Width="5" Height="5" Fill="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                      <TextBlock x:Name="BadgeText" Text="{DynamicResource BadgeIdle}" Margin="6,0,0,0" FontFamily="{StaticResource MonoFont}" FontSize="9" Foreground="{StaticResource MutedBrush}" />
                    </StackPanel>
                  </Border>
                </Grid>

                <ItemsControl x:Name="StepsList" ItemTemplate="{StaticResource StepRowTemplate}" />

                <Border BorderThickness="0,1,0,0" BorderBrush="{StaticResource LineSoftBrush}" Padding="11,9,11,11">
                  <StackPanel>
                    <Grid Margin="0,0,0,7">
                      <TextBlock x:Name="ProgressLabel" Text="{DynamicResource ProgressIdle}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                      <TextBlock x:Name="PercentText" HorizontalAlignment="Right" FontFamily="{StaticResource MonoFont}" FontSize="9.5" Foreground="{StaticResource DimBrush}" Text="0%" />
                    </Grid>
                    <Grid Height="4">
                      <Border CornerRadius="2" Background="{StaticResource TrackBrush}" />
                      <Border x:Name="BarFill" CornerRadius="2" RenderTransformOrigin="0,0.5" Background="{StaticResource AccentBarBrush}">
                        <Border.RenderTransform>
                          <ScaleTransform x:Name="BarScale" ScaleX="0" />
                        </Border.RenderTransform>
                        <Border.Effect>
                          <DropShadowEffect Color="#8B5CF6" ShadowDepth="0" BlurRadius="10" Opacity="0.7" />
                        </Border.Effect>
                      </Border>
                    </Grid>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <Button x:Name="LaunchButton" Style="{StaticResource PrimaryButton}" Margin="0,0,0,11" Click="Launch_Click" AutomationProperties.Name="{Binding Text, ElementName=LaunchText}">
              <StackPanel Orientation="Horizontal">
                <Path x:Name="LaunchIcon" Data="{x:Static core:Icons.Play}" Width="15" Height="15" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                <TextBlock x:Name="LaunchText" Text="{DynamicResource LaunchStart}" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                <Ellipse x:Name="LaunchSpinner" Width="13" Height="13" Margin="8,0,0,0" Visibility="Collapsed" StrokeDashArray="5 14" StrokeThickness="1.6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center">
                  <Ellipse.RenderTransform>
                    <RotateTransform x:Name="LaunchSpinRotate" />
                  </Ellipse.RenderTransform>
                </Ellipse>
              </StackPanel>
            </Button>

            <Border Style="{StaticResource Card}" CornerRadius="10" Background="#05050A" Margin="0,0,0,11" Padding="9,7,9,6">
              <StackPanel>
                <Grid Margin="0,0,0,4">
                  <TextBlock Text="{DynamicResource LogTitle}" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource FaintBrush}" VerticalAlignment="Center" />
                  <Button HorizontalAlignment="Right" Style="{StaticResource LinkButton}" Click="ClearLog_Click">
                    <TextBlock Text="{DynamicResource LogClear}" FontSize="9" FontWeight="SemiBold" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                  </Button>
                </Grid>
                <ScrollViewer x:Name="LogScroll" MaxHeight="42" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                  <ItemsControl x:Name="LogList" ItemTemplate="{StaticResource LogRowTemplate}" />
                </ScrollViewer>
              </StackPanel>
            </Border>

            <Grid Margin="2,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid VerticalAlignment="Center" Margin="0,0,10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ModeDot" Width="5" Height="5" Fill="{StaticResource OkBrush}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" x:Name="ModeText" Text="{DynamicResource ModeOffline}" FontSize="10" Foreground="{StaticResource DimBrush}" Margin="6,0,0,0" TextTrimming="CharacterEllipsis" />
              </Grid>
              <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource FooterLink}" Click="Site_Click">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{x:Static core:Icons.Globe}" Style="{StaticResource Glyph}" Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource LinkSite}" FontSize="10" Margin="5,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterLink}" Click="Source_Click" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{x:Static core:Icons.Code}" Style="{StaticResource Glyph}" Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource LinkSource}" FontSize="10" Margin="5,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource FooterLink}" Click="Docs_Click" Margin="12,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="{x:Static core:Icons.Book}" Style="{StaticResource Glyph}" Width="11" Height="11" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource LinkDocs}" FontSize="10" Margin="5,0,0,0" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
