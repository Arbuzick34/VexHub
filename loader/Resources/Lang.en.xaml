<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <sys:String x:Key="AppTitle">VexHub Loader</sys:String>
  <sys:String x:Key="Eyebrow">VEXHUB LOADER</sys:String>
  <sys:String x:Key="Heading">Launch VexHub</sys:String>
  <sys:String x:Key="Subheading">External client · read-only · no injection</sys:String>
  <sys:String x:Key="SessionLabel">SESSION</sys:String>
  <sys:String x:Key="BadgeIdle">READY</sys:String>
  <sys:String x:Key="BadgeRunning">STARTING</sys:String>
  <sys:String x:Key="BadgeActive">ACTIVE</sys:String>
  <sys:String x:Key="BadgeError">ERROR</sys:String>
  <sys:String x:Key="ProgressIdle">Ready to launch</sys:String>
  <sys:String x:Key="ProgressBusy">Starting the client</sys:String>
  <sys:String x:Key="ProgressDone">Client is running</sys:String>
  <sys:String x:Key="ProgressFailed">Launch failed</sys:String>
  <sys:String x:Key="LaunchStart">Launch VexHub</sys:String>
  <sys:String x:Key="LaunchBusy">Starting…</sys:String>
  <sys:String x:Key="LaunchClose">Close loader</sys:String>
  <sys:String x:Key="LaunchRetry">Try again</sys:String>
  <sys:String x:Key="LogTitle">SESSION LOG</sys:String>
  <sys:String x:Key="LogClear">Clear</sys:String>
  <sys:String x:Key="ModeOffline">External client · no injection</sys:String>
  <sys:String x:Key="LinkSite">Website</sys:String>
  <sys:String x:Key="LinkSource">Source</sys:String>
  <sys:String x:Key="LinkDocs">Docs</sys:String>
  <sys:String x:Key="MinTooltip">Minimize</sys:String>
  <sys:String x:Key="CloseTooltip">Close</sys:String>
  <sys:String x:Key="LangTooltip">Switch language</sys:String>

  <sys:String x:Key="StepClientTitle">Locate VexHub client</sys:String>
  <sys:String x:Key="StepClientPending">Queued</sys:String>
  <sys:String x:Key="StepClientActive">Resolving vexhub.exe…</sys:String>
  <sys:String x:Key="StepClientDone">vexhub.exe · ready</sys:String>
  <sys:String x:Key="StepClientError">Not found</sys:String>
  <sys:String x:Key="StepClientFound">vexhub.exe · v{0}</sys:String>

  <sys:String x:Key="StepGameTitle">Check Counter-Strike 2</sys:String>
  <sys:String x:Key="StepGamePending">Queued</sys:String>
  <sys:String x:Key="StepGameActive">Scanning processes…</sys:String>
  <sys:String x:Key="StepGameDone">cs2.exe found</sys:String>
  <sys:String x:Key="StepGameWarn">Not running</sys:String>
  <sys:String x:Key="StepGameError">Check failed</sys:String>
  <sys:String x:Key="StepGamePid">cs2.exe · pid {0}</sys:String>
  <sys:String x:Key="StepGameWarnDetail">not running · VexHub will wait</sys:String>

  <sys:String x:Key="StepStartTitle">Start VexHub</sys:String>
  <sys:String x:Key="StepStartPending">Queued</sys:String>
  <sys:String x:Key="StepStartActive">Launching client…</sys:String>
  <sys:String x:Key="StepStartDone">Started</sys:String>
  <sys:String x:Key="StepStartError">Failed to start</sys:String>
  <sys:String x:Key="StepStartPid">started · pid {0}</sys:String>
  <sys:String x:Key="StepStartRunning">already running · pid {0}</sys:String>

  <sys:String x:Key="StepReadyTitle">Prepare session</sys:String>
  <sys:String x:Key="StepReadyPending">Queued</sys:String>
  <sys:String x:Key="StepReadyActive">Finishing up…</sys:String>
  <sys:String x:Key="StepReadyDone">Ready · press Insert</sys:String>
  <sys:String x:Key="StepReadyError">Failed</sys:String>

  <sys:String x:Key="ErrorVexHubMissing">vexhub.exe is missing next to the loader. Put the loader in the VexHub folder.</sys:String>
  <sys:String x:Key="ErrorStart">Could not start vexhub.exe: {0}</sys:String>
</ResourceDictionary>
